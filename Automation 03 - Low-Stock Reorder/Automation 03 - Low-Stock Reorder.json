    {
      "id": "a47348c6-89d6-4b3b-90b3-32f62b1e6972",
      "name": "Check Stock Levels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Config').first().json;\nconst clean = (v) => String(v ?? '').trim();\nconst money = (n) => Number(n).toFixed(2);\nconst local = $now.setZone('Asia/Singapore');\nconst stamp = local.toFormat('yyyy-MM-dd HH:mm');\nconst poDate = local.toFormat('yyyyMMdd-HHmm');\nconst prefix = cfg.test_mode ? '[TEST] ' : '';\nconst procurement = cfg.test_mode ? cfg.test_email : cfg.procurement_email;\nconst inventory = $('Read Inventory').all().map((i) => i.json).filter((r) => clean(r.sku));\nconst vendors = $('Read Vendors').all().map((i) => i.json).filter((v) => clean(v.sku));\nconst out = [];\nconst orders = {};\nif (inventory.length === 0) {\n  return [{ json: { route: 'exception', logged_at: stamp, sku: '', item: '', problem: 'The Inventory tab returned no rows', to_email: procurement, subject: prefix + 'Stock check problem', body: 'The Inventory tab returned no rows, so stock could not be checked.', lines: [] } }];\n}\nconst addProblem = (r, problem, flag) => out.push({ json: {\n  route: 'exception', logged_at: stamp, sku: clean(r.sku), item: clean(r.item), problem, to_email: procurement,\n  subject: prefix + 'Stock alert needs attention: ' + clean(r.sku),\n  body: 'Item: ' + clean(r.item) + ' (' + clean(r.sku) + ')\\nOn hand: ' + clean(r.qty_on_hand) + '\\nMinimum: ' + clean(r.reorder_min) + '\\n\\nProblem: ' + problem,\n  lines: flag ? [{ sku: clean(r.sku), alert_sent: flag, last_alert: stamp }] : [],\n} });\nfor (const r of inventory) {\n  const qty = Number(r.qty_on_hand);\n  const min = Number(r.reorder_min);\n  const target = Number(clean(r.reorder_target) || r.reorder_min);\n  const flag = clean(r.alert_sent).toLowerCase();\n  if (clean(r.qty_on_hand) === '' || clean(r.reorder_min) === '' || isNaN(qty) || isNaN(min) || isNaN(target)) {\n    if (flag !== 'needs fixing') addProblem(r, 'Quantity or minimum cannot be read', 'needs fixing');\n    continue;\n  }\n  if (qty >= min) {\n    if (flag) out.push({ json: { route: 'restocked', sku: clean(r.sku) } });\n    continue;\n  }\n  if (flag === 'yes') continue;\n  const vendor = vendors.find((v) => clean(v.sku) === clean(r.sku));\n  const price = vendor ? Number(vendor.unit_price_sgd) : NaN;\n  const pack = vendor ? Number(vendor.pack_size) : NaN;\n  if (!vendor || !clean(vendor.vendor_email) || isNaN(price) || !(pack > 0)) {\n    if (flag !== 'vendor missing') addProblem(r, 'No complete approved vendor record for this SKU', 'vendor missing');\n    continue;\n  }\n  const need = Math.max(target - qty, min - qty);\n  const packs = Math.ceil(need / pack);\n  const orderQty = packs * pack;\n  const lineTotal = orderQty * price;\n  const key = clean(vendor.vendor_id);\n  if (!orders[key]) orders[key] = { vendor, lines: [], text: [], total: 0 };\n  orders[key].lines.push({ sku: clean(r.sku), alert_sent: 'yes', last_alert: stamp });\n  orders[key].text.push(clean(r.sku) + ' ' + clean(r.item) + ': ' + packs + ' pack(s) of ' + pack + ' = ' + orderQty + ' units at SGD ' + money(price) + ' = SGD ' + money(lineTotal) + ' (on hand ' + qty + ', minimum ' + min + ')');\n  orders[key].total += lineTotal;\n}\nfor (const key of Object.keys(orders)) {\n  const order = orders[key];\n  const poNumber = 'PO-' + poDate + '-' + key;\n  const lines = order.text.join('\\n');\n  out.unshift({ json: {\n    route: 'po', po_number: poNumber, created_at: stamp, vendor_id: key, vendor_name: clean(order.vendor.vendor_name),\n    vendor_email: clean(order.vendor.vendor_email), po_lines: lines, total_sgd: money(order.total), status: 'Draft', lines: order.lines, to_email: procurement,\n    subject: prefix + 'Reorder draft ' + poNumber + ': ' + clean(order.vendor.vendor_name),\n    body: 'Please review this draft purchase order.\\n\\nPO number: ' + poNumber + '\\nVendor: ' + clean(order.vendor.vendor_name) + ' (' + key + ')\\nContact: ' + clean(order.vendor.contact_name) + ', ' + clean(order.vendor.vendor_email) + '\\n\\n' + lines + '\\n\\nTotal: SGD ' + money(order.total),\n  } });\n}\nreturn out;"
      }
    },
