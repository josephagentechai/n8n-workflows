{
  "name": "Automation 05 - Feedback Logging and Escalation",
  "nodes": [
    {
      "id": "aa7fd1ce-f16e-4bcb-8b62-23cdc1f67cff",
      "name": "Feedback Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        400
      ],
      "parameters": {
        "authentication": "none",
        "formTitle": "Customer Feedback",
        "formDescription": "Tell us how we did. It takes less than a minute.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Account Number",
              "fieldType": "text",
              "placeholder": "e.g. AC-2041",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "placeholder": "e.g. name@example.com",
              "requiredField": true
            },
            {
              "fieldLabel": "Score",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "1 - Very poor"
                  },
                  {
                    "option": "2 - Poor"
                  },
                  {
                    "option": "3 - Okay"
                  },
                  {
                    "option": "4 - Good"
                  },
                  {
                    "option": "5 - Excellent"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Comment",
              "fieldType": "textarea",
              "placeholder": "Tell us what happened"
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "appendAttribution": false,
          "ignoreBots": true,
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Thank you. We have received your feedback."
            }
          }
        }
      }
    },
