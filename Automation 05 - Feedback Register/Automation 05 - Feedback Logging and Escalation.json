    {
      "id": "373bbb23-f1b2-462c-9524-b11799b3d3ef",
      "name": "Find Overdue Cases",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        760
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Reminder Config').first().json;\nconst clean = (v) => String(v ?? '').trim();\nconst local = $now.setZone('Asia/Singapore');\nconst stamp = local.toFormat('yyyy-MM-dd HH:mm');\nconst nowMs = local.toMillis();\nconst parse = (s) => Date.parse(clean(s).replace(' ', 'T') + ':00+08:00');\nconst out = [];\nfor (const item of $('Read Open Cases').all()) {\n  const c = item.json;\n  if (clean(c.priority) !== 'High' || clean(c.status) !== 'Open' || clean(c.resolved_at)) continue;\n  const due = parse(c.callback_due);\n  if (isNaN(due) || nowMs < due) continue;\n  if (clean(c.reminded_at) && (nowMs - parse(c.reminded_at)) / 3600000 < 23) continue;\n  out.push({ json: {\n    case_id: clean(c.case_id), reminded_at: stamp, to_email: cfg.test_mode ? cfg.test_email : cfg.manager_email,\n    subject: (cfg.test_mode ? '[TEST] ' : '') + 'Callback overdue: ' + clean(c.case_id),\n    body: 'Case: ' + clean(c.case_id) + '\\nAccount: ' + clean(c.account_no) + '\\nCustomer: ' + clean(c.customer_email) + '\\nScore: ' + clean(c.score) + '\\nComment: ' + clean(c.comment) + '\\nCallback was due: ' + clean(c.callback_due) + '\\n\\nPlease call the customer, then set status to Closed and fill resolved_at in the Register tab.',\n  } });\n}\nreturn out;"
      }
    },
