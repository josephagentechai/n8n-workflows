    {
      "id": "c7e5a635-051d-407e-b2c3-37ab074ec830",
      "name": "Tidy and Sanitise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Config').first().json;\nconst f = $('Feedback Form').first().json;\nconst clean = (v) => String(v ?? '').replace(/[ \\t]+/g, ' ').trim();\nconst safe = (v) => clean(v).replace(/^[=+@-]+/, '').trim();\nconst score = Number(clean(f['Score']).slice(0, 1));\nconst validScore = Number.isInteger(score) && score >= 1 && score <= 5;\nconst high = !validScore || score <= 2;\nconst hours = Number(cfg.callback_hours) || 24;\nconst due = $now.setZone('Asia/Singapore').plus({ hours }).toFormat('yyyy-MM-dd HH:mm');\nconst sendTo = (real) => (cfg.test_mode ? cfg.test_email : real);\nreturn [{ json: {\n  case_id: cfg.case_id, submitted_at: cfg.submitted_at, account_no: safe(f['Account Number']).toUpperCase(), customer_email: clean(f['Email']).toLowerCase(),\n  score: validScore ? score : clean(f['Score']), comment: safe(f['Comment']), priority: high ? 'High' : 'Standard', status: high ? 'Open' : 'Closed',\n  owner: high ? clean(cfg.manager_name) : '', callback_due: high ? due : '', reminded_at: '', resolved_at: '',\n  to_manager: sendTo(cfg.manager_email), to_customer: sendTo(clean(f['Email'])), subject_prefix: cfg.test_mode ? '[TEST] ' : '',\n} }];"
      }
    },
