    {
      "id": "9d7b1b8f-b569-4bff-bcb8-84bf01e18028",
      "name": "Pick Invoices to Chase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Config').first().json;\nconst clean = (v) => String(v ?? '').trim();\nconst toISO = (v) => {\n  const s = clean(v).slice(0, 10);\n  return /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(s) && !isNaN(Date.parse(s + 'T00:00:00Z')) ? s : '';\n};\nconst dayGap = (a, b) => Math.round((Date.parse(a + 'T00:00:00Z') - Date.parse(b + 'T00:00:00Z')) / 86400000);\nconst money = (n) => Number(n).toFixed(2);\nconst local = $now.setZone('Asia/Singapore');\nconst today = local.toFormat('yyyy-MM-dd');\nconst loggedAt = local.toFormat('yyyy-MM-dd HH:mm');\nconst stages = clean(cfg.reminder_days).split(',').map((d) => Number(d.trim())).filter((d) => d > 0);\nconst chase = clean(cfg.chase_statuses).split(',').map((s) => s.trim().toLowerCase());\nconst skip = clean(cfg.skip_statuses).split(',').map((s) => s.trim().toLowerCase());\nconst gap = Number(cfg.min_days_between_reminders) || 5;\nconst rows = $('Read Receivables').all().map((i) => i.json).filter((r) => clean(r.invoice_no));\nconst out = [];\nconst sent = [];\nconst problems = [];\nconst finalNotices = [];\nconst addProblem = (r, problem) => {\n  const row = { route: 'exception', logged_at: loggedAt, invoice_no: clean(r.invoice_no), client_name: clean(r.client_name), problem };\n  out.push({ json: row });\n  problems.push(row);\n};\nfor (const r of rows) {\n  const status = clean(r.status).toLowerCase();\n  if (skip.includes(status)) continue;\n  if (!chase.includes(status)) { addProblem(r, 'Unknown status: ' + (clean(r.status) || 'blank')); continue; }\n  const email = clean(r.client_email);\n  const due = toISO(r.due_date);\n  const amount = Number(r.amount_sgd);\n  const paid = Number(clean(r.paid_sgd) || 0);\n  if (!due) { addProblem(r, 'Due date cannot be read: ' + (clean(r.due_date) || 'blank')); continue; }\n  if (clean(r.amount_sgd) === '' || isNaN(amount) || isNaN(paid)) { addProblem(r, 'Amount cannot be read'); continue; }\n  const owing = amount - paid;\n  if (owing <= 0) { addProblem(r, 'Status is ' + clean(r.status) + ' but nothing is owing'); continue; }\n  const overdue = dayGap(today, due);\n  if (overdue <= 0) continue;\n  if (!/^[^@ ]+@[^@ ]+[.][^@ ]+$/.test(email)) { addProblem(r, 'Client email is missing or invalid'); continue; }\n  const count = Number(clean(r.reminder_count) || 0) || 0;\n  if (count >= stages.length) { finalNotices.push(clean(r.invoice_no) + ' ' + clean(r.client_name) + ': SGD ' + money(owing) + ', ' + overdue + ' days overdue'); continue; }\n  if (overdue < stages[count]) continue;\n  const lastReminded = toISO(r.last_reminded);\n  if (lastReminded && dayGap(today, lastReminded) < gap) continue;\n  const stage = count + 1;\n  const opening = stage === 1 ? 'Our records show this invoice is now past due. If you have already paid, please ignore this note.'\n    : stage === stages.length ? 'This is our final reminder before our finance team calls you.'\n    : 'We have not yet received payment for this invoice.';\n  const body = 'Dear ' + clean(r.client_name) + ',\\n\\n' + opening + '\\n\\n'\n    + 'Invoice: ' + clean(r.invoice_no) + '\\nDue date: ' + due + '\\nAmount owing: SGD ' + money(owing) + '\\n\\n'\n    + 'Pay by PayNow to UEN ' + clean(cfg.paynow_uen) + ' and use ' + clean(r.invoice_no) + ' as the reference.\\n\\n'\n    + 'Thank you,\\n' + clean(cfg.company_name) + ' Finance';\n  const subject = (cfg.test_mode ? '[TEST] ' : '') + 'Payment reminder ' + stage + ' of ' + stages.length + ': invoice ' + clean(r.invoice_no);\n  out.push({ json: { route: 'reminder', invoice_no: clean(r.invoice_no), to_email: cfg.test_mode ? cfg.test_email : email, subject, body, reminder_count: stage, last_reminded: today } });\n  sent.push(clean(r.invoice_no) + ' ' + clean(r.client_name) + ': SGD ' + money(owing) + ', reminder ' + stage);\n}\nconst list = (items) => (items.length ? items.map((t) => '- ' + t).join('\\n') : 'None');\nconst summary = 'Invoice reminder run for ' + today + '\\n\\nInvoices checked: ' + rows.length\n  + '\\n\\nReminders to send (' + sent.length + '):\\n' + list(sent)\n  + '\\n\\nAll reminders used, please call (' + finalNotices.length + '):\\n' + list(finalNotices)\n  + '\\n\\nProblems to fix (' + problems.length + '):\\n' + list(problems.map((p) => p.invoice_no + ': ' + p.problem));\nout.push({ json: { route: 'summary', to_email: cfg.test_mode ? cfg.test_email : cfg.finance_email, subject: (cfg.test_mode ? '[TEST] ' : '') + 'Daily receivables summary: ' + today, body: summary } });\nreturn out;"
      }
