    {
      "id": "bfdd0119-59f2-45f8-93c1-6a5ea9f59f36",
      "name": "Check and Route Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Config').first().json;\nconst f = $('Lead Form').first().json;\nconst clean = (v) => String(v ?? '').trim();\nconst safe = (v) => clean(v).replace(/^[=+@-]+/, '').trim();\nconst leads = $('Read Leads').all().map((i) => i.json).filter((l) => clean(l.lead_id));\nconst email = clean(f['Email']).toLowerCase();\nconst country = safe(f['Country']);\nconst postal = clean(f['Postal Code']).replace(/[^0-9A-Za-z]/g, '');\nconst phone = clean(f['Phone']).replace(/[^0-9+() -]/g, '');\nconst consent = Array.isArray(f['PDPA Consent']) ? f['PDPA Consent'].length > 0 : clean(f['PDPA Consent']) !== '';\nconst trap = clean(f['website_url']);\nconst name = safe(f['Full Name']);\nconst enquiry = safe(f['Enquiry']);\nconst sendTo = (real) => (cfg.test_mode ? cfg.test_email : real);\nconst base = {\n  lead_id: cfg.lead_id, submitted_at: cfg.submitted_at, name, email, phone, company: safe(f['Company']), country,\n  postal_code: postal, budget: safe(f['Budget']), enquiry, pdpa_consent: consent ? 'Yes' : 'No', contacted_at: '', reminded_at: '',\n  subject_prefix: cfg.test_mode ? '[TEST] ' : '',\n};\nconst fallback = { rep_name: clean(cfg.fallback_rep_name), rep_email: clean(cfg.fallback_rep_email), rep_phone: clean(cfg.fallback_rep_phone) };\nconst done = (outcome, rep) => [{ json: { ...base, outcome, status: outcome === 'New' ? 'New' : 'Closed', rep_name: rep.rep_name, rep_email: rep.rep_email, rep_phone: rep.rep_phone, to_rep: sendTo(rep.rep_email), to_prospect: sendTo(email) } }];\nconst none = { rep_name: '', rep_email: '', rep_phone: '' };\nconst validEmail = /^[^@ ]+@[^@ ]+[.][^@ ]+$/.test(email);\nconst hasLink = /https?:|www[.]/i.test(name);\nif (trap || !validEmail || hasLink) return done('Spam', none);\nif (!consent) return done('No Consent', none);\nconst windowDays = Number(cfg.duplicate_window_days) || 90;\nconst nowMs = Date.parse(clean(cfg.submitted_at).replace(' ', 'T') + ':00+08:00');\nconst prior = leads.filter((l) => clean(l.email).toLowerCase() === email && clean(l.outcome) === 'New').find((l) => {\n  const seen = Date.parse(clean(l.submitted_at).replace(' ', 'T') + ':00+08:00');\n  return !isNaN(seen) && (nowMs - seen) / 86400000 <= windowDays;\n});\nif (prior) return done('Duplicate', { rep_name: clean(prior.rep_name), rep_email: clean(prior.rep_email), rep_phone: '' });\nconst territories = $('Read Territories').all().map((i) => i.json)\n  .filter((t) => clean(t.active).toLowerCase() === 'yes' && clean(t.country).toLowerCase() === country.toLowerCase());\nconst prefixMatches = territories.filter((t) => clean(t.postal_prefix) && postal.startsWith(clean(t.postal_prefix)));\nconst longest = prefixMatches.reduce((m, t) => Math.max(m, clean(t.postal_prefix).length), 0);\nlet pool = prefixMatches.filter((t) => clean(t.postal_prefix).length === longest);\nif (pool.length === 0) pool = territories.filter((t) => !clean(t.postal_prefix));\nif (pool.length === 0) return done('New', fallback);\nconst load = (rep) => leads.filter((l) => clean(l.rep_email).toLowerCase() === clean(rep.rep_email).toLowerCase() && clean(l.outcome) === 'New').length;\nconst chosen = pool.slice().sort((a, b) => load(a) - load(b))[0];\nreturn done('New', { rep_name: clean(chosen.rep_name), rep_email: clean(chosen.rep_email), rep_phone: clean(chosen.rep_phone) });"
      }
    },
