        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Reminder Config').first().json;\nconst clean = (v) => String(v ?? '').trim();\nconst local = $now.setZone('Asia/Singapore');\nconst stamp = local.toFormat('yyyy-MM-dd HH:mm');\nconst nowMs = local.toMillis();\nconst limit = Number(cfg.contact_limit_hours) || 24;\nconst parse = (s) => Date.parse(clean(s).replace(' ', 'T') + ':00+08:00');\nconst out = [];\nfor (const item of $('Read Open Leads').all()) {\n  const l = item.json;\n  if (clean(l.outcome) !== 'New' || clean(l.status) !== 'New' || clean(l.contacted_at)) continue;\n  const age = (nowMs - parse(l.submitted_at)) / 3600000;\n  if (isNaN(age) || age < limit) continue;\n  if (clean(l.reminded_at) && (nowMs - parse(l.reminded_at)) / 3600000 < limit - 1) continue;\n  out.push({ json: {\n    lead_id: clean(l.lead_id), reminded_at: stamp, to_email: cfg.test_mode ? cfg.test_email : clean(l.rep_email),\n    subject: (cfg.test_mode ? '[TEST] ' : '') + 'Lead not yet contacted: ' + clean(l.name),\n    body: 'Hi ' + clean(l.rep_name) + ',\\n\\nThis lead has waited ' + Math.floor(age) + ' hours.\\n\\nName: ' + clean(l.name) + '\\nCompany: ' + clean(l.company) + '\\nPhone: ' + clean(l.phone) + '\\nEmail: ' + clean(l.email) + '\\n\\nPlease contact them, then set status to Contacted in the Leads tab.',\n  } });\n}\nreturn out;"
      }
    },
